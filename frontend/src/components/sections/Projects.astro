---
import { projects, smallProjects } from "../../data/projects";
import ProjectCard from "../projects/ProjectCard.astro";
---
<section id="projects" class="board-width section-space" aria-labelledby="projects-title">
  <div class="section-heading"><span class="section-number">01 /</span><h2 id="projects-title">Selected projects</h2><span class="chalk-hand section-aside">from the inside out</span></div>
  <div>{projects.map((project, index) => <ProjectCard project={project} index={index} />)}</div>
  <div class="more-projects" aria-labelledby="more-projects-title">
    <div class="more-projects-heading"><span class="section-number">ALSO /</span><h3 id="more-projects-title">Other things I've built</h3></div>
    <div class="more-project-grid">
      {smallProjects.map(project => <article class="small-project">
        <p class="project-meta">{project.period}</p>
        <h4>{project.title}</h4>
        <p class="project-tech">{project.tech}</p>
        <p>{project.summary}</p>
        <div class="project-links">
          {project.repoUrl && <a class="text-link" href={project.repoUrl}>Source code ↗</a>}
          {project.devpostUrl && <a class="text-link" href={project.devpostUrl}>Devpost ↗</a>}
        </div>
      </article>)}
    </div>
  </div>
</section>
