---
import { education } from "../../data/education";
---
<section id="education" class="mx-auto max-w-3xl px-4 py-16">
  <h2 class="chalk-heading chalk-underline mb-8 text-3xl text-chalk">Education</h2>
  <div class="chalk-panel p-6">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h3 class="text-xl font-semibold text-chalk">{education.school}</h3>
      <span class="chalk-hand text-lg text-chalk-yellow">{education.period}</span>
    </div>
    <p class="mt-1 text-chalk-blue">{education.program} &middot; {education.location}</p>
    <p class="mt-3 text-chalk-dim">Cumulative GPA: <span class="text-chalk">{education.gpa}</span></p>
    <p class="mt-3 text-chalk-dim">
      Relevant coursework: {education.coursework.join(", ")}.
    </p>
  </div>
</section>
