---
import { skills, interests } from "../../data/skills";
---
<section id="skills" class="mx-auto max-w-3xl px-4 py-16">
  <h2 class="chalk-heading chalk-underline mb-8 text-3xl text-chalk">Skills &amp; Interests</h2>
  <div class="grid gap-6 sm:grid-cols-2">
    {Object.entries(skills).map(([category, items]) => (
      <div class="chalk-panel p-5">
        <h3 class="chalk-hand text-xl text-chalk-yellow">{category}</h3>
        <div class="mt-3 flex flex-wrap gap-2">
          {items.map((item) => <span class="chalk-badge">{item}</span>)}
        </div>
      </div>
    ))}
    <div class="chalk-panel p-5 sm:col-span-2">
      <h3 class="chalk-hand text-xl text-chalk-yellow">Interests</h3>
      <div class="mt-3 flex flex-wrap gap-2">
        {interests.map((item) => <span class="chalk-badge">{item}</span>)}
      </div>
    </div>
  </div>
</section>
